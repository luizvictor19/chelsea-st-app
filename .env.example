# Supabase project settings. Copy to .env.local and fill in.
# .env.local is git-ignored and must never be committed.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_. A legacy anon key (eyJ...) is
# refused with 401 since #149.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser. Used only to send school invites
# (src/lib/supabase/admin.ts). Secret key, starts with sb_secret_ (locally the
# one named default). A legacy service_role key (eyJ...) is refused with 401.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used for magic link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. The contact address of the Chelsea brand, shown as "Dúvidas" on the
# screen of an account with no access (src/app/dashboard/account-pending.tsx).
NEXT_PUBLIC_TEACHER_CONTACT_EMAIL=

# Server only, optional. The exact Host (name, and port when there is one) that
# is served as GrifoAI (src/lib/brand.ts). Empty in production until the domain
# exists (#193). Locally, grifoai.localhost:3100 shows the GrifoAI brand at
# http://grifoai.localhost:3100.
GRIFOAI_HOST=

# Freepik API keys.
FREEPIK_API_KEY=

# DeepSeek API key.
DEEPSEEK_API_KEY=

# OpenAI API key.
OPENAI_API_KEY=

# Deepgram API key.
DEEPGRAM_API_KEY=

# Anthropic API key. Read only by the measurement scripts, never by the app.
ANTHROPIC_API_KEY=