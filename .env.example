# Supabase project settings. Copy to .env.local and fill in.
# .env.local is git-ignored and must never be committed.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_. A legacy anon key (eyJ...) is
# refused with 401 since #149.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser. Used only to send organization invites
# (src/lib/supabase/admin.ts). Secret key, starts with sb_secret_ (locally the
# one named default). A legacy service_role key (eyJ...) is refused with 401.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The contact address of the Chelsea brand, shown as "Dúvidas" on the
# screen of an account with no access (src/app/dashboard/account-pending.tsx).
NEXT_PUBLIC_TEACHER_CONTACT_EMAIL=

# Server only, optional. The exact Host (name, and port when there is one) that
# is served as GrifoAI (src/lib/brand.ts). Empty in production until the domain
# exists (#193). Locally, grifoai.localhost:3100 shows the GrifoAI brand at
# http://grifoai.localhost:3100.
GRIFOAI_HOST=

# Freepik API keys.
FREEPIK_API_KEY=

# DeepSeek API key. Read only by the measurement scripts; the app does not
# read it since #225.
DEEPSEEK_API_KEY=

# OpenAI API key.
OPENAI_API_KEY=

# Deepgram API key.
DEEPGRAM_API_KEY=

# Anthropic API key. Read by the app (the four content suggestions: the scene's
# and the word's "Sugerir instrução", #187, "Sugerir tipos" and "Sugerir
# conjuntos", #225) and by the measurement scripts. Locally the Console key named
# chelsea-local; Vercel Production holds chelsea-vercel. Each rotates alone.
ANTHROPIC_API_KEY=
# Asaas (#72). Server only. A sandbox key starts with $aact_hmlg_, a production
# key with $aact_prod_, and the address follows the key. Write it with a
# backslash, ASAAS_API_KEY=\$aact_..., because Next reads $aact_ as a
# variable and the key comes out empty. Vercel Production refuses the sandbox
# key: the database is production.
ASAAS_API_KEY=

# The token Asaas sends in the asaas-access-token header of the webhook,
# 32 to 255 characters (openssl rand -hex 32). The same value goes into the
# webhook at Asaas through scripts/asaas-webhook.ts.
ASAAS_WEBHOOK_TOKEN=

# The key of the HMAC the app keeps of a CPF (one trial per CPF), at least 32
# characters (openssl rand -hex 32). Changing it makes every CPF new again.
BILLING_CPF_KEY=

# Resend, for the billing e-mails of the overdue routine. A key of its own,
# sending only, separate from the one in Supabase's SMTP.
RESEND_API_KEY=

# The secret Vercel Cron sends as Authorization: Bearer to /api/billing/daily,
# at least 32 characters. Vercel Production only.
CRON_SECRET=
