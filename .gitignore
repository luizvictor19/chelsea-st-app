!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local environment
.env
.env.local
.env.*.local

# Tesseract language data, downloaded on first run, not ours to vendor.
*.traineddata

# Bytecode from importing the prototype in the calibration script.
__pycache__/

# Supabase CLI
.branches
.temp

# Book pages, and the archives they arrive in, never enter the repository.
# The whole directory is ignored rather than a subpath, so dropping another
# book's pages in here cannot commit them by accident. Synthetic fixtures are
# produced by a committed generator at test time, not stored as images.
#
# Anchored to the root: unanchored, this matched any directory called fixtures
# anywhere in the tree, which silently swallowed source files under one.
#
# No trailing slash, which is the difference between ignoring the pages and
# ignoring the name. A trailing slash matches directories only, and a symlink
# is a blob: working in a git worktree, where the pages are reached by linking
# this name at the real directory, the link itself was not ignored and went
# into a commit, carrying an absolute path out of one machine and leaving a
# dangling link in every clone. Without the slash the name is ignored whatever
# is behind it.
/fixtures

# Claude Code local state
.claude/settings.local.json
