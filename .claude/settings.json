{
  "enabledMcpjsonServers": ["supabase"],
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git pull)",
      "Bash(npm ci)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -d:*)",
      "Bash(git push origin --delete:*)",
      "Bash(npm run check)"
    ],
    "deny": [
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase db pull*)",
      "Bash(supabase migration up*)",
      "Bash(psql*)",
      "Bash(vercel --prod*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-commit-on-main.sh"
          }
        ]
      }
    ]
  }
}
