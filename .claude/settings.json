{
  "enabledMcpjsonServers": ["supabase"],
  "permissions": {
    "allow": [
      "EnterWorktree",
      "ExitWorktree",
      "Bash(git pull)",
      "Bash(npm ci)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -d:*)",
      "Bash(git push origin --delete:*)",
      "Bash(npm run check)",
      "Bash(cp /home/thinker/Projects/chelsea-st-app/.env.local /home/thinker/Projects/chelsea-st-app-:*)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run test:coverage)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(git merge-tree *)",
      "Bash(git check-ignore *)",
      "Bash(supabase migration list *)",
      "Bash(gh label list *)",
      "mcp__supabase__execute_sql",
      "mcp__supabase__query_logs",
      "mcp__supabase__list_migrations"
    ],
    "deny": [
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(supabase db reset*)",
      "Bash(supabase db pull*)",
      "Bash(supabase migration up*)",
      "Bash(psql*)",
      "Bash(vercel --prod*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main.sh"
          }
        ]
      }
    ]
  }
}
